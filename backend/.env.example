# Cổng chạy server
PORT=4000

# URL công khai của backend (dùng để nhúng link xác thực và metadata vào QR code)
PUBLIC_BASE_URL=http://localhost:4000

# URL trang frontend xác thực (người dùng quét QR sẽ được dẫn tới đây)
FRONTEND_VERIFY_URL=http://localhost:5173/verify.html
FRONTEND_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# RPC của mạng blockchain — mặc định trỏ tới Hardhat local node
RPC_URL=http://127.0.0.1:8545

# Thông tin mạng dùng khi frontend yêu cầu MetaMask thêm/chuyển mạng
# 0x7a69 = 31337 (chainId mặc định của Hardhat local node), đổi nếu bạn dùng mạng khác
CHAIN_ID_HEX=0x7a69
CHAIN_NAME=Hardhat Local

# Địa chỉ hợp đồng — sẽ được tự động ghi vào src/data/contract.json sau khi deploy,
# nhưng có thể override thủ công tại đây nếu cần
CONTRACT_ADDRESS=

# --- Lưu trữ metadata lên IPFS thật (mục 1.3 trong đề cương) ---
# Đăng ký miễn phí tại https://app.pinata.cloud/register → vào mục
# "API Keys" → "New Key" → tick quyền "pinJSONToIPFS" (hoặc chọn Admin) →
# tạo xong copy đoạn "JWT" (chuỗi rất dài bắt đầu bằng "eyJ...") dán vào đây.
# Nếu để trống, hệ thống tự dùng bản lưu cục bộ (chỉ dùng để demo/dev,
# không phải IPFS thật).
PINATA_JWT=
# Gateway dùng để đọc lại metadata từ CID — để mặc định là dùng gateway công khai của Pinata
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# LƯU Ý KIẾN TRÚC: backend KHÔNG còn giữ private key của bất kỳ vai trò nào.
# Mọi giao dịch ghi lên blockchain (mint, transferCustody...) được ký trực
# tiếp từ ví MetaMask của người dùng ngay trên trình duyệt (xem frontend/js/web3.js).

# --- Đăng nhập trang quản trị (MongoDB + JWT) ---
# Cách nhanh nhất: đăng ký miễn phí tại https://www.mongodb.com/cloud/atlas/register
# → tạo Cluster miễn phí (M0) → Database Access: tạo user/password → Network
# Access: Allow Access From Anywhere (0.0.0.0/0, đủ dùng cho demo/dev) →
# Connect → Drivers → copy "connection string" dạng mongodb+srv://...
# rồi thay <password> bằng mật khẩu bạn vừa tạo, dán vào đây:
MONGODB_URI=

# Chuỗi bí mật dùng để ký JWT — tự nghĩ ra một chuỗi ký tự ngẫu nhiên bất kỳ,
# càng dài càng khó đoán càng tốt. KHÔNG dùng chuỗi mặc định này khi triển khai thật.
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Trên Render (production) backend sẽ TỪ CHỐI KHỞI ĐỘNG nếu secret ngắn hơn 32 ký tự
# hoặc vẫn là chuỗi mẫu — vì ai biết secret này đều tự tạo được token admin giả.
JWT_SECRET=
# Thời hạn phiên đăng nhập
JWT_EXPIRES_IN=8h
# Khoá tài khoản tạm thời sau N lần sai mật khẩu
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# --- Phát hiện quét bất thường (nghi ngờ mã QR bị sao chép) ---
# Số thiết bị KHÁC NHAU tối đa coi là bình thường cho cùng 1 sản phẩm —
# vượt ngưỡng này sẽ bị đánh dấu suspicious=true.
SCAN_MAX_DEVICES=3
# Tổng số lượt quét tối đa (không phân biệt thiết bị) trước khi bị đánh dấu bất thường.
SCAN_MAX_TOTAL=15

# --- Cảnh báo bảo mật qua Telegram ---
# 1. Mở Telegram, chat với @BotFather → /newbot → lấy token
# 2. Nhắn 1 tin bất kỳ cho bot vừa tạo, rồi mở
#    https://api.telegram.org/bot<TOKEN>/getUpdates → lấy "chat":{"id": ...}
# Bỏ trống thì vẫn ghi nhật ký vào MongoDB (xem ở admin.html → Bảo mật).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mức thấp nhất được gửi Telegram: info | warning | critical
ALERT_MIN_SEVERITY=warning

# --- Mã hoá thông tin cá nhân người mua (BẮT BUỘC trên Render) ---
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MẤT KHOÁ = MẤT DỮ LIỆU đơn hàng đã mã hoá. Lưu thêm 1 bản ở trình quản lý mật khẩu.
# Thêm cả vào GitHub Secrets (DATA_ENCRYPTION_KEY) để bộ giám sát chạy bù việc xoá dữ liệu quá hạn.
DATA_ENCRYPTION_KEY=
# Xoá thông tin cá nhân người mua N ngày sau khi giao hàng (đơn chưa giao: sau MAX ngày)
ORDER_RETENTION_DAYS=90
ORDER_MAX_RETENTION_DAYS=180
# 1 tài khoản bấm "Xem đầy đủ" quá N đơn/giờ → cảnh báo / chặn
REVEAL_ALERT_PER_HOUR=20
REVEAL_LIMIT_PER_HOUR=50

# --- Phiên đăng nhập ---
SESSION_IDLE_MINUTES=30   # tự đăng xuất khi không thao tác
SESSION_MAX_HOURS=8       # tuổi tối đa 1 phiên
# true = tài khoản admin BẮT BUỘC bật xác thực 2 lớp mới dùng được chức năng quản trị
REQUIRE_ADMIN_2FA=false

# --- Telegram cho từng người dùng (nút "Không phải tôi") ---
# Tên bot (không có @), lấy lúc tạo bot với @BotFather
TELEGRAM_BOT_USERNAME=
# Chuỗi bí mật bất kỳ 16–64 ký tự (chữ, số, _ -) — Telegram gửi kèm mỗi lần gọi webhook
TELEGRAM_WEBHOOK_SECRET=
# Sau khi deploy Render, chạy 1 lần: cd backend && node scripts/telegram-setup.js

# --- Mã cào dùng 1 lần ---
# Mã chỉ lưu dạng HMAC với khoá suy ra từ DATA_ENCRYPTION_KEY → ĐỔI khoá đó thì
# mọi mã cào CHƯA kích hoạt sẽ không dùng được nữa (phải cấp lại & in lại tem).
CLAIM_MAX_FAILED=5        # nhập sai N lần → khoá nhập mã của sản phẩm đó
CLAIM_LOCK_MINUTES=60
