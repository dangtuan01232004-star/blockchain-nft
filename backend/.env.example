# Cổng chạy server
PORT=4000

# URL công khai của backend (dùng để nhúng link xác thực và metadata vào QR code)
PUBLIC_BASE_URL=http://localhost:4000

# URL trang frontend xác thực (người dùng quét QR sẽ được dẫn tới đây)
FRONTEND_VERIFY_URL=http://localhost:5173/verify.html

# RPC của mạng blockchain — mặc định trỏ tới Hardhat local node
RPC_URL=http://127.0.0.1:8545

# Thông tin mạng dùng khi frontend yêu cầu MetaMask thêm/chuyển mạng
# 0x7a69 = 31337 (chainId mặc định của Hardhat local node), đổi nếu bạn dùng mạng khác
CHAIN_ID_HEX=0x7a69
CHAIN_NAME=Hardhat Local

# Địa chỉ hợp đồng — sẽ được tự động ghi vào src/data/contract.json sau khi deploy,
# nhưng có thể override thủ công tại đây nếu cần
CONTRACT_ADDRESS=

# --- Lưu trữ metadata lên IPFS thật (mục 1.3 trong đề cương) ---
# Đăng ký miễn phí tại https://app.pinata.cloud/register → vào mục
# "API Keys" → "New Key" → tick quyền "pinJSONToIPFS" (hoặc chọn Admin) →
# tạo xong copy đoạn "JWT" (chuỗi rất dài bắt đầu bằng "eyJ...") dán vào đây.
# Nếu để trống, hệ thống tự dùng bản lưu cục bộ (chỉ dùng để demo/dev,
# không phải IPFS thật).
PINATA_JWT=
# Gateway dùng để đọc lại metadata từ CID — để mặc định là dùng gateway công khai của Pinata
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# LƯU Ý KIẾN TRÚC: backend KHÔNG còn giữ private key của bất kỳ vai trò nào.
# Mọi giao dịch ghi lên blockchain (mint, transferCustody...) được ký trực
# tiếp từ ví MetaMask của người dùng ngay trên trình duyệt (xem frontend/js/web3.js).

# --- Đăng nhập trang quản trị (MongoDB + JWT) ---
# Cách nhanh nhất: đăng ký miễn phí tại https://www.mongodb.com/cloud/atlas/register
# → tạo Cluster miễn phí (M0) → Database Access: tạo user/password → Network
# Access: Allow Access From Anywhere (0.0.0.0/0, đủ dùng cho demo/dev) →
# Connect → Drivers → copy "connection string" dạng mongodb+srv://...
# rồi thay <password> bằng mật khẩu bạn vừa tạo, dán vào đây:
MONGODB_URI=

# Chuỗi bí mật dùng để ký JWT — tự nghĩ ra một chuỗi ký tự ngẫu nhiên bất kỳ,
# càng dài càng khó đoán càng tốt. KHÔNG dùng chuỗi mặc định này khi triển khai thật.
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-kho-doan

# --- Phát hiện quét bất thường (nghi ngờ mã QR bị sao chép) ---
# Số thiết bị KHÁC NHAU tối đa coi là bình thường cho cùng 1 sản phẩm —
# vượt ngưỡng này sẽ bị đánh dấu suspicious=true.
SCAN_MAX_DEVICES=3
# Tổng số lượt quét tối đa (không phân biệt thiết bị) trước khi bị đánh dấu bất thường.
SCAN_MAX_TOTAL=15
