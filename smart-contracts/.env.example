# Chỉ cần điền khi deploy lên mạng công khai (Sepolia...).
# Deploy lên Hardhat local (npx hardhat node) thì KHÔNG cần file .env này.

# RPC endpoint của Sepolia — lấy miễn phí tại:
#   https://www.alchemy.com (đăng ký → Create App → chọn Sepolia → copy HTTPS URL)
#   hoặc https://infura.io (tương tự)
SEPOLIA_RPC_URL=

# Private key ví MetaMask của bạn — dùng để deploy + trả gas.
# Cách lấy: MetaMask → 3 chấm cạnh tên tài khoản → Account details →
# Show private key (nhập mật khẩu MetaMask để xác nhận).
# ⚠️ TUYỆT ĐỐI không commit file .env này lên GitHub, không chia sẻ private key
# này cho ai — dù chỉ là ví Sepolia (testnet), vẫn nên coi như ví thật.
PRIVATE_KEY=

# (Tuỳ chọn) Địa chỉ ví thật của nhà sản xuất/phân phối để cấp quyền ngay
# lúc deploy. Nếu bỏ trống, script sẽ báo bạn tự gọi grantRole() sau.
# Nếu demo một mình, có thể điền cùng 1 địa chỉ ví (chính ví bạn) cho cả 2.
MANUFACTURER_ADDRESS=
DISTRIBUTOR_ADDRESS=
